{
  "rewrites": [
    { "source": "/email-confirmed.html", "destination": "/email-confirmed.html" },
    { "source": "/r/", "destination": "/index.html" },
    { "source": "/r/(.*)", "destination": "/index.html" },
    { "source": "/auth/confirmed", "destination": "/auth/confirmed/index.html" },
    { "source": "/auth/confirmed/", "destination": "/auth/confirmed/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
